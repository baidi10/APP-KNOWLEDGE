# ============================================================
#   AdoptAI - App Knowledge Base :: Environment Configuration
#   Copy this file to `.env` and fill in your actual values.
# ============================================================

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
APP_NAME="AdoptAI App Knowledge Base"
APP_VERSION="0.1.0"
APP_DESCRIPTION="Centralized knowledge base API for AdoptAI applications"
DEBUG=True
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ----------------------------------------------------------
# PostgreSQL Database
# Format: postgresql+psycopg2://user:password@host:port/dbname
# ----------------------------------------------------------
DATABASE_URL="postgresql+psycopg2://postgres:your_password@localhost:5432/adoptai_kb"

# ----------------------------------------------------------
# Security (for future auth stages)
# ----------------------------------------------------------
SECRET_KEY="change-me-to-a-long-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
